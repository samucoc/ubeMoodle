# ============================================
# Application
# ============================================
APP_NAME=MoodleNext
APP_PORT=4000
APP_ENV=development
APP_URL=http://localhost:4000
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# Database - PostgreSQL
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=moodlenext
DB_PASSWORD=moodlenext_secret_2024
DB_DATABASE=moodlenext
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_SSL=false

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRATION=7d

# ============================================
# File Upload
# ============================================
UPLOAD_DEST=./uploads
UPLOAD_MAX_SIZE=52428800
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,application/zip,video/mp4,audio/mpeg

# ============================================
# Rate Limiting
# ============================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ============================================
# Mail (SMTP)
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@moodlenext.com

# ============================================
# Bull Queue (Redis)
# ============================================
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug
